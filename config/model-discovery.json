{
  "schema_version": "1.0.0",
  "enabled": true,
  "max_pages_per_source": 8,
  "max_details_per_source": 100,
  "max_response_bytes": 3000000,
  "timeout_ms": 20000,
  "sources": [
    {
      "id": "discovery-openai-docs",
      "vendor_id": "vendor-openai",
      "type": "official-model-index",
      "url": "https://developers.openai.com/api/docs/models/all",
      "adapter": "openai-docs",
      "parser_version": "1",
      "authority": "vendor",
      "enabled": true,
      "cadence": "daily",
      "allowed_domains": ["developers.openai.com"],
      "id_pattern": "^(gpt-|o[1-9]|chatgpt-|codex-)[a-zA-Z0-9._-]+$",
      "availability_semantics": "Documentation confirms identity, not account access."
    },
    {
      "id": "discovery-anthropic-docs",
      "vendor_id": "vendor-anthropic",
      "type": "official-model-index",
      "url": "https://platform.claude.com/docs/en/models/overview",
      "adapter": "anthropic-docs",
      "parser_version": "1",
      "authority": "vendor",
      "enabled": true,
      "cadence": "daily",
      "allowed_domains": ["platform.claude.com"],
      "id_pattern": "^claude-[a-zA-Z0-9._-]+$",
      "availability_semantics": "Claude API ID row, not Bedrock or consumer identity."
    },
    {
      "id": "discovery-google-docs",
      "vendor_id": "vendor-google",
      "type": "official-model-index",
      "url": "https://ai.google.dev/gemini-api/docs/models?hl=en",
      "adapter": "google-docs",
      "parser_version": "1",
      "authority": "vendor",
      "enabled": true,
      "cadence": "daily",
      "allowed_domains": ["ai.google.dev"],
      "id_pattern": "^gemini-[a-zA-Z0-9._-]+$",
      "availability_semantics": "Endpoint column confirms ID, not account access."
    },
    {
      "id": "discovery-xai-docs",
      "vendor_id": "vendor-xai",
      "type": "official-model-index",
      "url": "https://docs.x.ai/developers/models",
      "adapter": "xai-docs",
      "parser_version": "1",
      "authority": "vendor",
      "enabled": true,
      "cadence": "daily",
      "allowed_domains": ["docs.x.ai"],
      "id_pattern": "^grok-[a-zA-Z0-9._-]+$",
      "availability_semantics": "Model documentation is not an access test."
    },
    {
      "id": "discovery-openai-api",
      "vendor_id": "vendor-openai",
      "type": "authenticated-model-list",
      "url": "https://api.openai.com/v1/models",
      "adapter": "openai-api",
      "parser_version": "1",
      "authority": "vendor",
      "enabled": true,
      "cadence": "daily",
      "allowed_domains": ["api.openai.com"],
      "credential_env": "OPENAI_API_KEY",
      "id_pattern": "^(gpt-|o[1-9]|chatgpt-|codex-)[a-zA-Z0-9._-]+$",
      "availability_semantics": "Listing confirms account-visible ID, not endpoint compatibility or successful generation."
    },
    {
      "id": "discovery-anthropic-api",
      "vendor_id": "vendor-anthropic",
      "type": "authenticated-model-list",
      "url": "https://api.anthropic.com/v1/models?limit=100",
      "adapter": "anthropic-api",
      "parser_version": "1",
      "authority": "vendor",
      "enabled": true,
      "cadence": "daily",
      "allowed_domains": ["api.anthropic.com"],
      "credential_env": "ANTHROPIC_API_KEY",
      "id_pattern": "^claude-[a-zA-Z0-9._-]+$",
      "availability_semantics": "Listing and explicit capabilities; no paid generation."
    },
    {
      "id": "discovery-google-api",
      "vendor_id": "vendor-google",
      "type": "authenticated-model-list",
      "url": "https://generativelanguage.googleapis.com/v1beta/models?pageSize=1000",
      "adapter": "google-api",
      "parser_version": "1",
      "authority": "vendor",
      "enabled": true,
      "cadence": "daily",
      "allowed_domains": ["generativelanguage.googleapis.com"],
      "credential_env": "GEMINI_API_KEY",
      "id_pattern": "^gemini-[a-zA-Z0-9._-]+$",
      "availability_semantics": "supportedGenerationMethods describes endpoints, not successful probes."
    },
    {
      "id": "discovery-xai-api",
      "vendor_id": "vendor-xai",
      "type": "authenticated-model-list",
      "url": "https://api.x.ai/v1/language-models",
      "adapter": "xai-api",
      "parser_version": "1",
      "authority": "vendor",
      "enabled": true,
      "cadence": "daily",
      "allowed_domains": ["api.x.ai"],
      "credential_env": "XAI_API_KEY",
      "id_pattern": "^grok-[a-zA-Z0-9._-]+$",
      "availability_semantics": "Listing confirms account-visible ID only."
    }
  ]
