  "scheduling": {
    "evaluate_new_relevant_models_immediately": true,
    "queue_initial_baseline_when_newly_testable": true,
    "rerun_unchanged_models": false,
    "tested_models_follow_freshness_policy": true
  },
  "provenance_contract": {
    "raw_runs_are_private_action_artifacts": true,
    "raw_artifact_retention_days": 90,
    "required_fields": [
      "provider_id",
      "requested_model_id",
      "returned_model_id",
      "surface_id",
      "endpoint",
      "executed_at",
      "methodology_version_id",
      "messages",
      "parameters",
      "tool_definitions",
      "raw_response",
      "normalized_evaluation",
      "evaluator_version",
      "originating_discovery_event_id",
      "commit_sha",
      "operational_errors"
    ],
    "operational_errors_are_behavioral_failures": false
  },
  "notes": "This policy enables deterministic eligibility assessment only. Paid inference remains disabled, no model is execution-allowlisted, and scheduled request and spend budgets are zero. API observations must never be projected onto consumer-product surfaces."
