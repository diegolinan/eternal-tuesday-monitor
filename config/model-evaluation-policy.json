{
  "schema_version": "1.0.0",
  "policy_id": "model-evaluation-adoption-v1",
  "eligibility_enabled": true,
  "execution_enabled": true,
  "surface_id": "surface-openai-model-api",
  "providers": [
    {
      "vendor_id": "vendor-openai",
      "enabled": true,
      "credential_env": "OPENAI_API_KEY"
    },
    {
      "vendor_id": "vendor-anthropic",
      "enabled": true,
      "credential_env": "ANTHROPIC_API_KEY"
    },
    {
      "vendor_id": "vendor-google",
      "enabled": true,
      "credential_env": "GEMINI_API_KEY"
    },
    {
      "vendor_id": "vendor-xai",
      "enabled": true,
      "credential_env": "XAI_API_KEY"
    }
  ],
  "eligible_api_ids": ["gpt-6-astra"],
  "manual_only_api_ids": [],
  "denied_api_ids": [],
  "harness_capabilities": [
    "exact_model_request",
    "raw_request_capture",
    "raw_response_capture",
    "operational_error_capture",
    "deterministic_evaluator",
    "controlled_tool_state"
  ],
  "execution": {
    "probe_allowlist": [
      "probe-temporal-anchor",
      "probe-elapsed",
      "probe-revalidation",
      "probe-state-reconciliation",
      "probe-historical-validity"
    ],
    "automatic_frontier": {
      "enabled": true,
      "after_discovered_on": "2026-09-05",
      "max_new_models_per_day": 1,
      "required_relevance_state": "DISCOVERED_RELEVANT",
      "vendor_ids": ["vendor-openai"]
    },
    "request_body_max_bytes": 2048,
    "max_output_tokens_per_request": 512,
    "cost_preflight": {
      "input_usd_per_million_ceiling": 10,
      "output_usd_per_million_ceiling": 50,
      "pricing_basis": "Conservative GPT-6 Astra text-token rates verified from the official OpenAI model page on 2026-09-05. A future model is blocked if these ceilings cannot contain its run."
    }
  },
  "limits": {
    "max_scheduled_requests_per_day": 8,
    "max_scheduled_spend_usd_per_day": 0.5,
    "max_runs_per_model_per_day": 1,
    "max_requests_per_run": 8,
    "max_provider_requests_per_run": 9,
    "max_retries": 0,
    "cooldown_hours": 168,
    "max_concurrency": 1
  },
  "probe_profiles": [
    {
      "probe_id": "probe-temporal-anchor",
      "status": "APPROVED",
      "testability": "API_TESTABLE",
      "methodology_version_id": "method-api-temporal-anchor-1",
      "provider_id": "vendor-openai",
      "endpoint": "responses",
      "required_model_capabilities": [
        "text_input_output",
        "structured_outputs",
        "snapshot_pinning"
      ],
      "required_harness_capabilities": [
        "exact_model_request",
        "raw_request_capture",
        "raw_response_capture",
        "operational_error_capture",
        "deterministic_evaluator"
      ],
      "evaluator_version": "temporal-anchor-explicit-offset-pilot-1"
    },
    {
      "probe_id": "probe-elapsed",
      "status": "APPROVED",
      "testability": "PARTIALLY_API_TESTABLE",
      "methodology_version_id": "method-api-elapsed-represented-1",
      "provider_id": "vendor-openai",
      "endpoint": "responses",
      "required_model_capabilities": ["text_input_output", "structured_outputs"],
      "required_harness_capabilities": ["raw_request_capture", "raw_response_capture", "deterministic_evaluator"],
      "evaluator_version": "elapsed-represented-interval-1"
    },
    {
      "probe_id": "probe-revalidation",
      "status": "APPROVED",
      "testability": "API_TESTABLE",
      "methodology_version_id": "method-api-revalidation-controlled-tool-1",
      "provider_id": "vendor-openai",
      "endpoint": "responses",
      "required_model_capabilities": ["text_input_output", "function_calling", "structured_outputs"],
      "required_harness_capabilities": ["raw_request_capture", "raw_response_capture", "controlled_tool_state", "deterministic_evaluator"],
      "evaluator_version": "revalidation-controlled-tool-1"
    },
    {
      "probe_id": "probe-state-reconciliation",
      "status": "APPROVED",
      "testability": "API_TESTABLE",
      "methodology_version_id": "method-api-state-reconciliation-1",
      "provider_id": "vendor-openai",
      "endpoint": "responses",
      "required_model_capabilities": ["text_input_output", "structured_outputs"],
      "required_harness_capabilities": ["raw_request_capture", "raw_response_capture", "deterministic_evaluator"],
      "evaluator_version": "state-reconciliation-controlled-transition-1"
    },
    {
      "probe_id": "probe-historical-validity",
      "status": "APPROVED",
      "testability": "PARTIALLY_API_TESTABLE",
      "methodology_version_id": "method-api-historical-validity-1",
      "provider_id": "vendor-openai",
      "endpoint": "responses",
      "required_model_capabilities": ["text_input_output", "structured_outputs"],
      "required_harness_capabilities": ["raw_request_capture", "raw_response_capture", "deterministic_evaluator"],
      "evaluator_version": "historical-validity-controlled-claims-1"
    }
  ],
  "scheduling": {
    "evaluate_new_relevant_models_immediately": true,
    "queue_initial_baseline_when_newly_testable": true,
    "rerun_unchanged_models": false,
    "tested_models_follow_freshness_policy": true
  },
  "provenance_contract": {
    "raw_runs_are_private_action_artifacts": true,
    "raw_artifact_retention_days": 90,
    "required_fields": [
      "provider_id",
      "requested_model_id",
      "returned_model_id",
      "surface_id",
      "endpoint",
      "executed_at",
      "methodology_version_id",
      "messages",
      "parameters",
      "tool_definitions",
      "raw_response",
      "normalized_evaluation",
      "evaluator_version",
      "originating_discovery_event_id",
      "commit_sha",
      "operational_errors"
    ],
    "operational_errors_are_behavioral_failures": false
  },
  "notes": "Controlled OpenAI API execution is enabled for one explicitly allowlisted initial frontier model and, generically, at most one newly discovered relevant frontier model per day. Eight inference requests, one authenticated metadata request, no retries, concurrency one, and a USD 0.50 daily reservation ceiling are hard limits. Results are API/model observations only and are never projected onto consumer-product surfaces."
}
