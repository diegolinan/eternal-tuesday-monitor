{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidateId",
    "status",
    "error",
    "candidateReady",
    "reviewStatus",
    "protocol",
    "surface",
    "requestedModel",
    "returnedModel",
    "reasoningEffort",
    "policySha256",
    "privateCandidateSha256",
    "startedAt",
    "finishedAt",
    "billing",
    "trials",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "candidateId": {
      "type": "string",
      "pattern": "^scheduled-codex-luna-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-f0-9]{8}$"
    },
    "status": { "enum": ["COMPLETED", "ABORTED"] },
    "error": {
      "type": ["string", "null"],
      "pattern": "^[A-Z][A-Z0-9_]{0,79}$"
    },
    "candidateReady": { "type": "boolean" },
    "reviewStatus": { "const": "PENDING_REVIEW" },
    "protocol": { "const": "codex-cli-explicit-offset-manual-1" },
    "surface": { "const": "experimental-codex-cli-chatgpt-local" },
    "requestedModel": { "const": "gpt-5.6-luna" },
    "returnedModel": { "type": "null" },
    "reasoningEffort": { "const": "low" },
    "policySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "privateCandidateSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "billing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "costUsd",
        "creditsCharged",
        "monetaryCapEnforced"
      ],
      "properties": {
        "channel": { "const": "CHATGPT_WORKSPACE" },
        "costUsd": { "type": "null" },
        "creditsCharged": { "type": "null" },
        "monetaryCapEnforced": { "const": false }
      }
    },
    "trials": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "testCase",
          "verdict",
          "expected",
          "actual",
          "usage",
          "captureSha256"
        ],
        "properties": {
          "testCase": { "type": "object" },
          "verdict": { "enum": ["MATCH", "MISMATCH"] },
          "expected": { "type": "object" },
          "actual": { "type": "object" },
          "usage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["inputTokens", "outputTokens"],
            "properties": {
              "inputTokens": {
                "type": "integer",
                "minimum": 0,
                "maximum": 32000
              },
              "outputTokens": {
                "type": "integer",
                "minimum": 0,
                "maximum": 512
              }
            }
          },
          "captureSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
