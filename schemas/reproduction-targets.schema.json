{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diegolinan.github.io/eternal-tuesday-monitor/schemas/reproduction-targets.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "planned_on", "targets"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "planned_on": { "type": "string", "format": "date" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/target" }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "candidate_id",
        "active_review_id",
        "model_id",
        "surface_id",
        "protocol_id",
        "probe_ids",
        "readiness",
        "execution_location",
        "blockers",
        "next_action"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^repro-[a-z0-9-]+$"
        },
        "candidate_id": {
          "type": "string",
          "pattern": "^evcand-[a-f0-9]{24}$"
        },
        "active_review_id": {
          "type": "string",
          "pattern": "^evreview-[a-f0-9]{24}$"
        },
        "model_id": { "type": "string", "minLength": 1 },
        "surface_id": { "type": ["string", "null"], "minLength": 1 },
        "protocol_id": { "type": ["string", "null"], "minLength": 1 },
        "probe_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "readiness": {
          "enum": [
            "COMPLETED_ACCEPTED_EVIDENCE",
            "READY_FOR_HUMAN_START",
            "READY_FOR_CREDENTIAL_PROVISIONING",
            "BLOCKED_EXACT_MODEL_AVAILABILITY",
            "NEEDS_SURFACE_SELECTION",
            "INTERACTIVE_HOST_REQUIRED"
          ]
        },
        "execution_location": {
          "enum": [
            "GITHUB_HOSTED_RUNNER",
            "CONTROLLED_INTERACTIVE_HOST",
            "UNRESOLVED"
          ]
        },
        "blockers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "next_action": { "type": "string", "minLength": 1 },
        "completion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["completed_on", "evidence_id"],
          "properties": {
            "completed_on": { "type": "string", "format": "date" },
            "evidence_id": { "type": "string", "minLength": 1 }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "readiness": { "const": "COMPLETED_ACCEPTED_EVIDENCE" }
            },
            "required": ["readiness"]
          },
          "then": {
            "required": ["completion"],
            "properties": {
              "blockers": { "type": "array", "maxItems": 0 }
            }
          }
        }
      ]
    }
  }
}
