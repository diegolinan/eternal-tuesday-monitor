{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eternal-tuesday-monitor.example/schemas/source.schema.json",
  "title": "Eternal Tuesday Monitor source",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "publisher", "source_type", "last_verified_on"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "publisher": { "type": "string", "minLength": 1 },
    "source_type": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "repository_path": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "article_reference_numbers": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1 }
    },
    "last_verified_on": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "notes": { "type": "string", "minLength": 1 }
  },
  "anyOf": [
    { "required": ["url"] },
    { "required": ["repository_path", "sha256"] }
  ]
}
