{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "reviewStatus",
    "protocol",
    "implementationSha256",
    "approval",
    "startedAt",
    "finishedAt",
    "reservationUsd",
    "status",
    "error",
    "preflight",
    "trials"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "mode": { "enum": ["LIVE", "FIXTURE"] },
    "reviewStatus": { "const": "PENDING_REVIEW" },
    "protocol": { "const": "temporal-anchor-explicit-offset-pilot-1" },
    "implementationSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "approval": { "type": "object" },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "reservationUsd": { "type": "number", "minimum": 0, "maximum": 1 },
    "status": { "enum": ["COMPLETED", "ABORTED"] },
    "error": { "type": ["string", "null"] },
    "preflight": { "type": ["object", "null"] },
    "trials": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "testCase",
          "request",
          "startedAt",
          "finishedAt",
          "durationMs",
          "exchange",
          "score",
          "estimatedUsageUsd"
        ],
        "properties": {
          "testCase": { "type": "object" },
          "request": { "type": "object" },
          "startedAt": { "type": "string", "format": "date-time" },
          "finishedAt": { "type": "string", "format": "date-time" },
          "durationMs": { "type": "number", "minimum": 0 },
          "exchange": { "type": ["object", "null"] },
          "score": { "type": "object" },
          "estimatedUsageUsd": { "type": ["number", "null"], "minimum": 0 }
        }
      }
    }
  }
}
