{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eternal-tuesday-monitor.example/schemas/model-evaluation-policy.schema.json",
  "title": "Model evaluation adoption and execution policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "eligibility_enabled",
    "execution_enabled",
    "surface_id",
    "providers",
    "eligible_api_ids",
    "manual_only_api_ids",
    "denied_api_ids",
    "harness_capabilities",
    "execution",
    "limits",
    "probe_profiles",
    "scheduling",
    "provenance_contract",
    "notes"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "policy_id": { "const": "model-evaluation-adoption-v1" },
    "eligibility_enabled": { "type": "boolean" },
    "execution_enabled": { "type": "boolean" },
    "surface_id": { "type": "string", "minLength": 1 },
    "providers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["vendor_id", "enabled", "credential_env"],
        "properties": {
          "vendor_id": { "type": "string", "minLength": 1 },
          "enabled": { "type": "boolean" },
          "credential_env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" }
        }
      }
    },
    "eligible_api_ids": { "$ref": "#/$defs/stringSet" },
    "manual_only_api_ids": { "$ref": "#/$defs/stringSet" },
    "denied_api_ids": { "$ref": "#/$defs/stringSet" },
    "harness_capabilities": { "$ref": "#/$defs/nonEmptyStringSet" },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probe_allowlist", "automatic_frontier", "request_body_max_bytes", "max_output_tokens_per_request", "cost_preflight"],
      "properties": {
        "probe_allowlist": { "$ref": "#/$defs/nonEmptyStringSet" },
        "automatic_frontier": {
          "type": "object", "additionalProperties": false,
          "required": ["enabled", "after_discovered_on", "max_new_models_per_day", "required_relevance_state", "vendor_ids"],
          "properties": {
            "enabled": { "type": "boolean" },
            "after_discovered_on": { "type": "string", "format": "date" },
            "max_new_models_per_day": { "type": "integer", "minimum": 0, "maximum": 1 },
            "required_relevance_state": { "const": "DISCOVERED_RELEVANT" },
            "vendor_ids": { "$ref": "#/$defs/nonEmptyStringSet" }
          }
        },
        "request_body_max_bytes": { "type": "integer", "minimum": 1 },
        "max_output_tokens_per_request": { "type": "integer", "minimum": 1 },
        "cost_preflight": {
          "type": "object", "additionalProperties": false,
          "required": ["input_usd_per_million_ceiling", "output_usd_per_million_ceiling", "pricing_basis"],
          "properties": {
            "input_usd_per_million_ceiling": { "type": "number", "minimum": 0 },
            "output_usd_per_million_ceiling": { "type": "number", "minimum": 0 },
            "pricing_basis": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_scheduled_requests_per_day",
        "max_scheduled_spend_usd_per_day",
        "max_runs_per_model_per_day",
        "max_requests_per_run",
        "max_provider_requests_per_run",
        "max_retries",
        "cooldown_hours",
        "max_concurrency"
      ],
      "properties": {
        "max_scheduled_requests_per_day": { "type": "integer", "minimum": 0 },
        "max_scheduled_spend_usd_per_day": { "type": "number", "minimum": 0 },
        "max_runs_per_model_per_day": { "type": "integer", "minimum": 0 },
        "max_requests_per_run": { "type": "integer", "minimum": 1 },
        "max_provider_requests_per_run": { "type": "integer", "minimum": 1 },
        "max_retries": { "type": "integer", "minimum": 0 },
        "cooldown_hours": { "type": "integer", "minimum": 0 },
        "max_concurrency": { "type": "integer", "minimum": 1 }
      }
    },
    "probe_profiles": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "probe_id",
          "status",
          "testability",
          "methodology_version_id",
          "provider_id",
          "endpoint",
          "required_model_capabilities",
          "required_harness_capabilities",
          "evaluator_version"
        ],
        "properties": {
          "probe_id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["APPROVED", "REVIEW_REQUIRED"] },
          "testability": { "enum": ["API_TESTABLE", "PARTIALLY_API_TESTABLE", "NOT_API_TESTABLE"] },
          "methodology_version_id": { "$ref": "#/$defs/nullableString" },
          "provider_id": { "$ref": "#/$defs/nullableString" },
          "endpoint": { "$ref": "#/$defs/nullableString" },
          "required_model_capabilities": { "$ref": "#/$defs/stringSet" },
          "required_harness_capabilities": { "$ref": "#/$defs/stringSet" },
          "evaluator_version": { "$ref": "#/$defs/nullableString" }
        }
      }
    },
    "scheduling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluate_new_relevant_models_immediately",
        "queue_initial_baseline_when_newly_testable",
        "rerun_unchanged_models",
        "tested_models_follow_freshness_policy"
      ],
      "properties": {
        "evaluate_new_relevant_models_immediately": { "type": "boolean" },
        "queue_initial_baseline_when_newly_testable": { "type": "boolean" },
        "rerun_unchanged_models": { "type": "boolean" },
        "tested_models_follow_freshness_policy": { "type": "boolean" }
      }
    },
    "provenance_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_runs_are_private_action_artifacts",
        "raw_artifact_retention_days",
        "required_fields",
        "operational_errors_are_behavioral_failures"
      ],
      "properties": {
        "raw_runs_are_private_action_artifacts": { "type": "boolean" },
        "raw_artifact_retention_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        },
        "required_fields": { "$ref": "#/$defs/nonEmptyStringSet" },
        "operational_errors_are_behavioral_failures": { "const": false }
      }
    },
    "notes": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "nonEmptyStringSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "nullableString": {
      "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    }
  }
}
