{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eternal-tuesday-monitor.example/schemas/model-evaluation-policy.schema.json",
  "title": "Non-executing model evaluation adoption policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "execution_enabled",
    "discovery_can_create_behavioral_verdicts",
    "providers",
    "probe_profiles",
    "notes"
  ],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "policy_id": { "const": "model-evaluation-adoption-v1" },
    "execution_enabled": { "const": false },
    "discovery_can_create_behavioral_verdicts": { "const": false },
    "providers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "probe_profiles": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["probe_id", "status"],
        "properties": {
          "probe_id": { "type": "string", "minLength": 1 },
          "status": { "const": "EVIDENCE_REQUIRED" }
        }
      }
    },
    "notes": { "type": "string", "minLength": 1 }
  }
}
