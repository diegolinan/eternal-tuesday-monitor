{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eternal-tuesday-monitor.example/schemas/model-evaluation-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "run_id", "model_id", "vendor_id", "api_model_id", "returned_model_id", "surface_id", "probe_id", "methodology_version_id", "evaluator_version", "executed_at", "verified_on", "status", "evidence_class_id", "request_count", "usage", "estimated_cost_usd", "machine_signals", "limitations", "raw_artifact", "originating_discovery_event_id", "commit_sha", "operational_error"],
  "properties": {
    "schema_version": { "const": "1.0.0" }, "id": { "type": "string" }, "run_id": { "type": "string" }, "model_id": { "type": "string" }, "vendor_id": { "type": "string" }, "api_model_id": { "type": "string" }, "returned_model_id": { "type": "string" }, "surface_id": { "const": "surface-openai-model-api" }, "probe_id": { "type": "string" }, "methodology_version_id": { "type": "string" }, "evaluator_version": { "type": "string" }, "executed_at": { "type": "string", "format": "date-time" }, "verified_on": { "type": "string", "format": "date" }, "status": { "enum": ["MATCH", "MISMATCH", "INCONCLUSIVE", "OPERATIONAL_ERROR"] }, "evidence_class_id": { "const": "evidence-controlled-experiment" }, "request_count": { "type": "integer", "minimum": 0 }, "usage": { "type": "object", "additionalProperties": false, "required": ["input_tokens", "output_tokens"], "properties": { "input_tokens": { "type": "integer", "minimum": 0 }, "output_tokens": { "type": "integer", "minimum": 0 } } }, "estimated_cost_usd": { "type": "number", "minimum": 0 }, "machine_signals": {}, "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "raw_artifact": { "type": "string" }, "originating_discovery_event_id": { "type": ["string", "null"] }, "commit_sha": { "type": "string" }, "operational_error": { "type": ["object", "null"] }
  }
}
