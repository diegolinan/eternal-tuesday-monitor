{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diegolinan.github.io/eternal-tuesday-monitor/schemas/surface-reproduction-policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "verified_on",
    "automatic_execution",
    "automatic_evidence_acceptance",
    "cross_surface_transfer",
    "exact_coordinates",
    "raw_artifact_retention_days",
    "protocols"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "policy_id": {
      "type": "string",
      "const": "surface-reproduction-policy-v1"
    },
    "verified_on": { "type": "string", "format": "date" },
    "automatic_execution": { "type": "boolean", "const": false },
    "automatic_evidence_acceptance": { "type": "boolean", "const": false },
    "cross_surface_transfer": { "type": "boolean", "const": false },
    "exact_coordinates": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "vendor_id",
          "model_id",
          "product_id",
          "surface_id",
          "product_version",
          "authentication_mode"
        ]
      }
    },
    "raw_artifact_retention_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 90
    },
    "protocols": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/protocol" }
    }
  },
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "execution_class",
        "implementation_state",
        "surface_ids",
        "probe_ids",
        "minimum_independent_trials",
        "human_start_required",
        "required_coordinates",
        "required_controls",
        "required_artifacts",
        "invalid_substitutions",
        "official_sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^protocol-[a-z0-9-]+-v1$"
        },
        "name": { "type": "string", "minLength": 1 },
        "execution_class": {
          "enum": [
            "SERVER_AUTOMATABLE",
            "SERVER_CAPABLE_EXACT_PRODUCT_BINARY",
            "INTERACTIVE_HOST_REQUIRED",
            "VENDOR_OR_INTERACTIVE_SURFACE_REQUIRED"
          ]
        },
        "implementation_state": {
          "enum": ["IMPLEMENTED", "PROTOCOL_DEFINED"]
        },
        "surface_ids": { "$ref": "#/$defs/nonEmptyStringArray" },
        "probe_ids": { "$ref": "#/$defs/nonEmptyStringArray" },
        "minimum_independent_trials": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "human_start_required": { "type": "boolean" },
        "required_coordinates": { "$ref": "#/$defs/nonEmptyStringArray" },
        "required_controls": { "$ref": "#/$defs/nonEmptyStringArray" },
        "required_artifacts": { "$ref": "#/$defs/nonEmptyStringArray" },
        "invalid_substitutions": { "$ref": "#/$defs/nonEmptyStringArray" },
        "official_sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "format": "uri" }
        }
      }
    }
  }
}
