{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocol",
    "surface",
    "mode",
    "reviewStatus",
    "approval",
    "implementationSha256",
    "requestedModel",
    "returnedModel",
    "billing",
    "startedAt",
    "finishedAt",
    "status",
    "error",
    "preflight",
    "trials"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "protocol": { "const": "codex-cli-explicit-offset-manual-1" },
    "surface": { "const": "experimental-codex-cli-chatgpt-local" },
    "mode": { "enum": ["LIVE", "FIXTURE"] },
    "reviewStatus": { "const": "PENDING_REVIEW" },
    "approval": { "type": "object" },
    "implementationSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "requestedModel": { "type": "string" },
    "returnedModel": { "type": "null" },
    "billing": {
      "const": {
        "channel": "CHATGPT_WORKSPACE",
        "costUsd": null,
        "creditsCharged": null,
        "monetaryCapEnforced": false
      }
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["COMPLETED", "ABORTED"] },
    "error": { "type": ["string", "null"] },
    "preflight": { "type": ["object", "null"] },
    "trials": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "testCase",
          "prompt",
          "startedAt",
          "finishedAt",
          "capture",
          "analysis"
        ],
        "properties": {
          "testCase": { "type": "object" },
          "prompt": { "type": "string", "maxLength": 8192 },
          "startedAt": { "type": "string", "format": "date-time" },
          "finishedAt": { "type": "string", "format": "date-time" },
          "capture": { "type": ["object", "null"] },
          "analysis": { "type": "object" }
        }
      }
    }
  }
}
