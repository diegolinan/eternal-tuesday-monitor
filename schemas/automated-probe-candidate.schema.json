{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidateId",
    "mode",
    "status",
    "error",
    "candidateReady",
    "reviewStatus",
    "protocol",
    "target",
    "policySha256",
    "startedAt",
    "finishedAt",
    "preflight",
    "trials",
    "totals",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "candidateId": {
      "type": "string",
      "pattern": "^auto-openai-gpt-5-4-mini-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-f0-9]{8}$"
    },
    "mode": { "enum": ["LIVE", "FIXTURE"] },
    "status": { "enum": ["DISABLED", "COMPLETED", "ABORTED"] },
    "error": {
      "type": ["string", "null"],
      "pattern": "^[A-Z][A-Z0-9_]{0,79}$"
    },
    "candidateReady": { "type": "boolean" },
    "reviewStatus": { "const": "PENDING_REVIEW" },
    "protocol": { "const": "temporal-anchor-explicit-offset-pilot-1" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendorId", "surfaceId", "requestedModel", "returnedModel"],
      "properties": {
        "vendorId": { "const": "vendor-openai" },
        "surfaceId": { "const": "surface-openai-model-api" },
        "requestedModel": { "const": "gpt-5.4-mini" },
        "returnedModel": { "type": ["string", "null"] }
      }
    },
    "policySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "preflight": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["httpStatus", "modelId", "responseSha256"],
      "properties": {
        "httpStatus": { "type": "integer", "minimum": 100, "maximum": 599 },
        "modelId": { "type": ["string", "null"] },
        "responseSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "trials": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "testCase",
          "requestSha256",
          "responseSha256",
          "returnedModel",
          "score",
          "usage",
          "estimatedUsageUsd"
        ],
        "properties": {
          "testCase": { "type": "object" },
          "requestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "responseSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "returnedModel": { "type": "string" },
          "score": { "type": "object" },
          "usage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["inputTokens", "outputTokens"],
            "properties": {
              "inputTokens": {
                "type": "integer",
                "minimum": 0,
                "maximum": 16384
              },
              "outputTokens": {
                "type": "integer",
                "minimum": 0,
                "maximum": 256
              }
            }
          },
          "estimatedUsageUsd": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputTokens", "outputTokens", "estimatedUsageUsd"],
      "properties": {
        "inputTokens": { "type": "integer", "minimum": 0, "maximum": 49152 },
        "outputTokens": { "type": "integer", "minimum": 0, "maximum": 768 },
        "estimatedUsageUsd": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
