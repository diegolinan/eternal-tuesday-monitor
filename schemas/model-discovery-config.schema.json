{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "enabled",
    "max_pages_per_source",
    "max_details_per_source",
    "max_response_bytes",
    "timeout_ms",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "enabled": {
      "type": "boolean"
    },
    "max_pages_per_source": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "max_details_per_source": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "max_response_bytes": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 10000000
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 30000
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "vendor_id",
          "type",
          "source_class",
          "url",
          "adapter",
          "adapter_version",
          "parser_version",
          "authority",
          "source_role",
          "structure",
          "discovery_semantics",
          "limitations",
          "expected_instability",
          "automatic_identity_acceptance",
          "enabled",
          "cadence",
          "allowed_domains",
          "id_pattern",
          "availability_semantics"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "vendor_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "type": {
            "enum": ["official-model-index", "official-product-changelog", "research-feed"]
          },
          "source_class": {
            "enum": ["official_model_documentation", "official_release_notes", "official_release_source", "research_publication_feed"]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "adapter": {
            "enum": [
              "openai-docs",
              "anthropic-docs",
              "google-docs",
              "xai-docs",
              "change-detection-html",
              "change-detection-feed"
            ]
          },
          "adapter_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "parser_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "authority": {
            "enum": ["vendor", "research-index"]
          },
          "source_role": {
            "enum": ["canonical-identity", "evidence-candidate"]
          },
          "structure": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "discovery_semantics": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "limitations": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "expected_instability": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "automatic_identity_acceptance": {
            "type": "boolean"
          },
          "enabled": {
            "type": "boolean"
          },
          "cadence": {
            "const": "daily"
          },
          "allowed_domains": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "uniqueItems": true,
            "maxItems": 200
          },
          "id_pattern": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "availability_semantics": {
            "type": "string",
            "maxLength": 500
          }
        }
      },
      "minItems": 1,
      "maxItems": 20
    }
  }
}
