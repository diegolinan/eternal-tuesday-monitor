{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "enabled",
    "max_pages_per_source",
    "max_details_per_source",
    "max_response_bytes",
    "timeout_ms",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "enabled": {
      "type": "boolean"
    },
    "max_pages_per_source": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "max_details_per_source": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "max_response_bytes": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 10000000
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 30000
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "vendor_id",
          "type",
          "url",
          "adapter",
          "parser_version",
          "authority",
          "enabled",
          "cadence",
          "allowed_domains",
          "id_pattern",
          "availability_semantics"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "vendor_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "type": {
            "enum": ["official-model-index", "authenticated-model-list"]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "adapter": {
            "enum": [
              "openai-docs",
              "anthropic-docs",
              "google-docs",
              "xai-docs",
              "openai-api",
              "anthropic-api",
              "google-api",
              "xai-api"
            ]
          },
          "parser_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "authority": {
            "const": "vendor"
          },
          "enabled": {
            "type": "boolean"
          },
          "cadence": {
            "const": "daily"
          },
          "allowed_domains": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "uniqueItems": true,
            "maxItems": 200
          },
          "id_pattern": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "availability_semantics": {
            "type": "string",
            "maxLength": 500
          },
          "credential_env": {
            "enum": [
              "OPENAI_API_KEY",
              "ANTHROPIC_API_KEY",
              "GEMINI_API_KEY",
              "XAI_API_KEY"
            ]
          }
        }
      },
      "minItems": 1,
      "maxItems": 20
    }
  }
}
