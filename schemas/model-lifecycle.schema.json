{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eternal-tuesday-monitor.example/schemas/model-lifecycle.schema.json",
  "title": "Public model coverage lifecycle record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "vendorId",
    "vendor",
    "name",
    "apiModelId",
    "releaseState",
    "relevanceState",
    "apiState",
    "accountAccess",
    "accountCheckedOn",
    "discoveredOn",
    "releasedOn",
    "firstTestedOn",
    "lastTestedOn",
    "lifecycleState",
    "testabilityState",
    "evaluationReasons",
    "apiAvailabilityState",
    "apiAvailabilityReasons",
    "adoptionAssessedOn",
    "queueState",
    "queueReasons",
    "executionState",
    "probeCoverage",
    "surfaces",
    "observationContexts",
    "sources",
    "reviewReasons",
    "defaultProminence"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "vendorId": { "type": "string", "pattern": "^vendor-[a-z0-9-]+$" },
    "vendor": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "apiModelId": {
      "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "releaseState": {
      "enum": [
        "UNKNOWN",
        "DISCOVERED",
        "RELEASED",
        "DEPRECATED",
        "RETIRED",
        "SUPERSEDED"
      ]
    },
    "relevanceState": {
      "enum": [
        "UNCLASSIFIED",
        "DISCOVERED_RELEVANT",
        "REVIEW_REQUIRED",
        "CATALOG_ONLY",
        "ACTIVE",
        "FRONTIER",
        "HISTORICAL",
        "SUPERSEDED"
      ]
    },
    "apiState": { "enum": ["API_UNKNOWN", "API_PENDING", "API_AVAILABLE"] },
    "accountAccess": {
      "enum": ["UNKNOWN", "ACCESS_CONFIRMED", "ACCESS_DENIED", "ERROR"]
    },
    "accountCheckedOn": {
      "oneOf": [{ "type": "string", "format": "date" }, { "type": "null" }]
    },
    "discoveredOn": {
      "oneOf": [{ "type": "string", "format": "date" }, { "type": "null" }]
    },
    "releasedOn": {
      "oneOf": [{ "type": "string", "format": "date" }, { "type": "null" }]
    },
    "firstTestedOn": {
      "oneOf": [{ "type": "string", "format": "date" }, { "type": "null" }]
    },
    "lastTestedOn": {
      "oneOf": [{ "type": "string", "format": "date" }, { "type": "null" }]
    },
    "lifecycleState": {
      "enum": [
        "DISCOVERED",
        "EVALUATION_PENDING",
        "EVALUATION_AVAILABLE",
        "EVALUATION_NOT_POSSIBLE",
        "TESTED",
        "RETEST_REQUIRED"
      ]
    },
    "testabilityState": {
      "enum": [
        "AVAILABLE",
        "NOT_CURRENTLY_AVAILABLE",
        "UNKNOWN_REVIEW_REQUIRED",
        "EVALUATABLE",
        "PARTIALLY_TESTABLE",
        "NOT_TESTABLE",
        "REVIEW_REQUIRED"
      ]
    },
    "evaluationReasons": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "apiAvailabilityState": {
      "enum": ["AVAILABLE", "UNAVAILABLE", "UNKNOWN", "AUTH_REQUIRED_TO_VERIFY"]
    },
    "apiAvailabilityReasons": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "adoptionAssessedOn": {
      "oneOf": [{ "type": "string", "format": "date" }, { "type": "null" }]
    },
    "queueState": {
      "enum": [
        "NOT_QUEUED",
        "ELIGIBILITY_READY",
        "BLOCKED",
        "ALREADY_TESTED",
        "RETEST_POLICY",
        "TEST_REQUIRED"
      ]
    },
    "queueReasons": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "executionState": {
      "enum": [
        "NOT_RUN",
        "COMPLETED",
        "OPERATIONAL_ERROR",
        "EXECUTION_BLOCKED_COST_POLICY"
      ]
    },
    "probeCoverage": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "state",
          "eligibilityState",
          "eligibilityReasons",
          "methodologyVersionId",
          "testability",
          "empiricalResult",
          "evidenceClass",
          "verifiedOn",
          "limitations",
          "requestCount"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "state": { "enum": ["NOT_TESTED", "TESTED", "RETEST_REQUIRED"] },
          "eligibilityState": {
            "enum": [
              "ELIGIBLE",
              "BLOCKED",
              "NOT_TESTABLE",
              "REVIEW_REQUIRED",
              "NOT_IN_SCOPE"
            ]
          },
          "eligibilityReasons": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "methodologyVersionId": {
            "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "testability": {
            "enum": [
              "API_TESTABLE",
              "PARTIALLY_API_TESTABLE",
              "NOT_API_TESTABLE"
            ]
          },
          "empiricalResult": {
            "type": ["string", "null"],
            "enum": [
              "MATCH",
              "MISMATCH",
              "INCONCLUSIVE",
              "OPERATIONAL_ERROR",
              null
            ]
          },
          "evidenceClass": { "type": ["string", "null"] },
          "verifiedOn": { "type": ["string", "null"], "format": "date" },
          "limitations": { "type": "array", "items": { "type": "string" } },
          "requestCount": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "product", "name", "kind"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "product": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["PROVIDER_API", "CONSUMER_PRODUCT_SURFACE"] }
        }
      }
    },
    "observationContexts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "product",
          "surface",
          "probe",
          "evidenceClass",
          "observedOn",
          "applicability"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "product": { "type": "string", "minLength": 1 },
          "surface": { "type": "string", "minLength": 1 },
          "probe": { "type": "string", "minLength": 1 },
          "evidenceClass": { "type": "string", "minLength": 1 },
          "observedOn": { "type": "string", "minLength": 1 },
          "applicability": { "enum": ["CURRENT", "HISTORICAL"] }
        }
      }
    },
    "sources": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "format": "uri" }
    },
    "reviewReasons": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "defaultProminence": { "type": "boolean" }
  }
}
