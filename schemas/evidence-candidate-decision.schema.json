{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diegolinan.github.io/eternal-tuesday-monitor/schemas/evidence-candidate-decision.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "decided_at",
    "candidate_batch_generated_at",
    "decision",
    "reason",
    "affected_count"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0", "type": "string" },
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
    "decided_at": { "type": "string", "format": "date-time" },
    "candidate_batch_generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision": { "const": "RETRACTED_PIPELINE_DEFECT", "type": "string" },
    "reason": { "type": "string", "minLength": 20, "maxLength": 600 },
    "affected_count": { "type": "integer", "minimum": 1 }
  }
}
