{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eternal-tuesday-monitor.example/schemas/freshness-policy.schema.json",
  "title": "Eternal Tuesday Monitor freshness policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "effective_on",
    "description",
    "boundary_rule",
    "rules"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^freshness-policy-[a-z0-9-]+$" },
    "effective_on": { "type": "string", "format": "date" },
    "description": { "type": "string", "minLength": 1 },
    "boundary_rule": { "type": "string", "minLength": 1 },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_class_id", "max_age_days"],
        "properties": {
          "evidence_class_id": { "type": "string", "minLength": 1 },
          "max_age_days": { "type": "integer", "minimum": 1, "maximum": 730 }
        }
      }
    }
  }
}
