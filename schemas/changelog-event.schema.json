{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eternal-tuesday-monitor.example/schemas/changelog-event.schema.json",
  "title": "Public monitor changelog event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "recorded_on", "type", "title", "summary", "source", "subjects", "source_urls", "pull_request_url", "affects_observations"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
    "recorded_on": { "type": "string", "format": "date" },
    "type": { "enum": ["AUTOMATION_STARTED", "MODEL_DISCOVERED", "MODEL_METADATA_UPDATED", "EVALUATION_REQUIRED", "EVIDENCE_ADDED", "OBSERVATION_ADDED", "OBSERVATION_SUPERSEDED", "PROBE_RESULT_RECORDED"] },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "source": { "enum": ["AUTOMATIC_POLICY", "HUMAN_REVIEW", "RELEASE"] },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "id", "label"],
        "properties": {
          "type": { "enum": ["model", "observation", "automation", "source"] },
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    },
    "source_urls": { "type": "array", "uniqueItems": true, "items": { "type": "string", "format": "uri" } },
    "pull_request_url": { "type": ["string", "null"], "format": "uri" },
    "affects_observations": { "type": "boolean" }
  }
}
