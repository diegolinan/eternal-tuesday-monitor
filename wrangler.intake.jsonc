{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eternal-tuesday-intake",
  "main": "worker/intake.mjs",
  "compatibility_date": "2026-09-06",
  "workers_dev": true,
  "secrets": {
    "required": ["TURNSTILE_SECRET_KEY", "GITHUB_REPOSITORY_TOKEN"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "ratelimits": [
    {
      "name": "SUBMISSION_RATE_LIMITER",
      "namespace_id": "730591",
      "simple": { "limit": 3, "period": 60 },
    },
    {
      "name": "SUBMISSION_GLOBAL_LIMITER",
      "namespace_id": "730592",
      "simple": { "limit": 12, "period": 60 },
    },
  ],
  "vars": {
    "GITHUB_REPOSITORY": "diegolinan/eternal-tuesday-monitor",
    "INTAKE_OPEN": "true",
    "INTAKE_HOURLY_BUDGET": "12",
    "INTAKE_DAILY_BUDGET": "40",
  },
}
