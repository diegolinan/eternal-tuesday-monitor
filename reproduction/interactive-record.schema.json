{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diegolinan.github.io/eternal-tuesday-monitor/reproduction/interactive-record.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["coordinates", "trials"],
  "properties": {
    "coordinates": { "$ref": "#/$defs/coordinates" },
    "trials": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/trial" }
    }
  },
  "$defs": {
    "coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "product",
        "surface",
        "product_version",
        "authentication_mode",
        "operating_system",
        "timezone"
      ],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "product": { "type": "string", "minLength": 1 },
        "surface": { "type": "string", "minLength": 1 },
        "product_version": { "type": "string", "minLength": 1 },
        "authentication_mode": { "type": "string", "minLength": 1 },
        "operating_system": { "type": "string", "minLength": 1 },
        "timezone": { "type": "string", "minLength": 1 }
      }
    },
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trial_number",
        "started_at",
        "finished_at",
        "fresh_session_confirmed",
        "capture_path",
        "transcript_path",
        "operator_observations",
        "probe_results"
      ],
      "properties": {
        "trial_number": { "type": "integer", "minimum": 1, "maximum": 3 },
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" },
        "fresh_session_confirmed": { "type": "boolean", "const": true },
        "capture_path": { "type": "string", "minLength": 1 },
        "transcript_path": { "type": "string", "minLength": 1 },
        "operator_observations": { "type": "string", "minLength": 1 },
        "probe_results": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/probeResult" }
        }
      }
    },
    "probeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probe_id", "status", "rationale", "evidence_path"],
      "properties": {
        "probe_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["PASS", "FAIL", "NOT_EVALUABLE"] },
        "rationale": { "type": "string", "minLength": 1 },
        "evidence_path": { "type": "string", "minLength": 1 }
      }
    }
  }
}
